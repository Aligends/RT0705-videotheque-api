# Proxy inverse HTTPS devant le site web (docker-compose.https.yml).
#
# NOM_DU_SITE (fichier .env) est le nom ou l'adresse IP que l'on tape dans le
# navigateur : « 192.168.1.20 » ou « videotheque.lab ». Les requêtes HTTP sont
# redirigées vers HTTPS ; toute autre adresse est refusée.
#
# Le certificat est émis par l'autorité interne de Caddy. Tant qu'elle n'est
# pas installée sur le poste, le navigateur affiche un avertissement : c'est
# attendu pour un TP. Avec un vrai nom de domaine joignable depuis Internet,
# supprimer la ligne « tls internal » : Caddy obtient alors un certificat reconnu.
{
	admin off
	skip_install_trust
	# Un navigateur qui se connecte par adresse IP n'annonce pas de nom :
	# le certificat du site est alors présenté par défaut.
	default_sni {$NOM_DU_SITE:localhost}
	servers {
		protocols h1 h2
	}
}

{$NOM_DU_SITE:localhost} {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
		-Via
	}
	reverse_proxy web:5000
}
