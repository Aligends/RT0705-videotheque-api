# Modèle du fichier .env. Ne pas le remplir à la main : lancer
#     scripts/init-env.sh
# qui crée .env avec des secrets aléatoires. Le fichier .env ne doit jamais
# être committé (il est dans .gitignore).

# Compte propriétaire de la base : administration et sauvegardes uniquement.
POSTGRES_PASSWORD=
# Compte « videotheque_api », à droits restreints, utilisé par l'API.
API_DB_PASSWORD=
# Clé de signature des jetons de l'API (32 caractères au minimum).
API_SECRET_KEY=
# Clé de signature du cookie de session du site (32 caractères au minimum).
WEB_SECRET_KEY=

# Premier administrateur, créé au démarrage de l'API s'il n'existe pas.
ADMIN_EMAIL=admin@videotheque.local
ADMIN_MOT_DE_PASSE=

# Inscriptions : validation (un administrateur active chaque compte),
# ouverte (compte utilisable tout de suite) ou fermee.
INSCRIPTION=validation
# 1 : charge les films, avis et prêts de démonstration à la création de la base.
DONNEES_DEMO=1
# Port du site en HTTP (docker-compose.override.yml).
WEB_PORT=8080
